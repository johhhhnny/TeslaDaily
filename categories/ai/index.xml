      <title>特斯拉FSD影子模式：自动驾驶数据飞轮的构建与产业竞争格局重塑</title>
      <link>https://johhhhnny.github.io/TeslaDaily/posts/20251203-%E7%89%B9%E6%96%AF%E6%8B%89fsd%E5%BD%B1%E5%AD%90%E6%A8%A1%E5%BC%8F%E8%87%AA%E5%8A%A8%E9%A9%BE%E9%A9%B6%E6%95%B0%E6%8D%AE%E9%A3%9E%E8%BD%AE%E7%9A%84%E6%9E%84%E5%BB%BA%E4%B8%8E%E4%BA%A7%E4%B8%9A%E7%AB%9E%E4%BA%89%E6%A0%BC%E5%B1%80%E9%87%8D%E5%A1%91/</link>
      <guid isPermaLink="true">https://johhhhnny.github.io/TeslaDaily/posts/20251203-%E7%89%B9%E6%96%AF%E6%8B%89fsd%E5%BD%B1%E5%AD%90%E6%A8%A1%E5%BC%8F%E8%87%AA%E5%8A%A8%E9%A9%BE%E9%A9%B6%E6%95%B0%E6%8D%AE%E9%A3%9E%E8%BD%AE%E7%9A%84%E6%9E%84%E5%BB%BA%E4%B8%8E%E4%BA%A7%E4%B8%9A%E7%AB%9E%E4%BA%89%E6%A0%BC%E5%B1%80%E9%87%8D%E5%A1%91/</guid>
