      <title>特斯拉发布行车记录仪遥测工具：开放车辆“黑匣子”数据</title>
      <link>https://johhhhnny.github.io/TeslaDaily/posts/20251209-%E7%89%B9%E6%96%AF%E6%8B%89%E5%8F%91%E5%B8%83%E8%A1%8C%E8%BD%A6%E8%AE%B0%E5%BD%95%E4%BB%AA%E9%81%A5%E6%B5%8B%E5%B7%A5%E5%85%B7%E5%BC%80%E6%94%BE%E8%BD%A6%E8%BE%86%E9%BB%91%E5%8C%A3%E5%AD%90%E6%95%B0%E6%8D%AE/</link>
      <guid isPermaLink="true">https://johhhhnny.github.io/TeslaDaily/posts/20251209-%E7%89%B9%E6%96%AF%E6%8B%89%E5%8F%91%E5%B8%83%E8%A1%8C%E8%BD%A6%E8%AE%B0%E5%BD%95%E4%BB%AA%E9%81%A5%E6%B5%8B%E5%B7%A5%E5%85%B7%E5%BC%80%E6%94%BE%E8%BD%A6%E8%BE%86%E9%BB%91%E5%8C%A3%E5%AD%90%E6%95%B0%E6%8D%AE/</guid>
