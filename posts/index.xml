      <title>特斯拉CEO埃隆·马斯克确认奥斯汀Robotaxi将移除安全监督员</title>
      <link>https://johhhhnny.github.io/TeslaDaily/posts/20251210-%E7%89%B9%E6%96%AF%E6%8B%89ceo%E5%9F%83%E9%9A%86%E9%A9%AC%E6%96%AF%E5%85%8B%E7%A1%AE%E8%AE%A4%E5%A5%A5%E6%96%AF%E6%B1%80robotaxi%E5%B0%86%E7%A7%BB%E9%99%A4%E5%AE%89%E5%85%A8%E7%9B%91%E7%9D%A3%E5%91%98/</link>
      <guid isPermaLink="true">https://johhhhnny.github.io/TeslaDaily/posts/20251210-%E7%89%B9%E6%96%AF%E6%8B%89ceo%E5%9F%83%E9%9A%86%E9%A9%AC%E6%96%AF%E5%85%8B%E7%A1%AE%E8%AE%A4%E5%A5%A5%E6%96%AF%E6%B1%80robotaxi%E5%B0%86%E7%A7%BB%E9%99%A4%E5%AE%89%E5%85%A8%E7%9B%91%E7%9D%A3%E5%91%98/</guid>
