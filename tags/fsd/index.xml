      <title>当钢铁之躯跑向未来：特斯拉擎天柱与FSD，一场未完待续的产业革命</title>
      <link>https://johhhhnny.github.io/TeslaDaily/posts/20251203-%E5%BD%93%E9%92%A2%E9%93%81%E4%B9%8B%E8%BA%AF%E8%B7%91%E5%90%91%E6%9C%AA%E6%9D%A5%E7%89%B9%E6%96%AF%E6%8B%89%E6%93%8E%E5%A4%A9%E6%9F%B1%E4%B8%8Efsd%E4%B8%80%E5%9C%BA%E6%9C%AA%E5%AE%8C%E5%BE%85%E7%BB%AD%E7%9A%84%E4%BA%A7%E4%B8%9A%E9%9D%A9%E5%91%BD/</link>
      <guid isPermaLink="true">https://johhhhnny.github.io/TeslaDaily/posts/20251203-%E5%BD%93%E9%92%A2%E9%93%81%E4%B9%8B%E8%BA%AF%E8%B7%91%E5%90%91%E6%9C%AA%E6%9D%A5%E7%89%B9%E6%96%AF%E6%8B%89%E6%93%8E%E5%A4%A9%E6%9F%B1%E4%B8%8Efsd%E4%B8%80%E5%9C%BA%E6%9C%AA%E5%AE%8C%E5%BE%85%E7%BB%AD%E7%9A%84%E4%BA%A7%E4%B8%9A%E9%9D%A9%E5%91%BD/</guid>
